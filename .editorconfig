# Ce qui tient l'indentation d'un contributeur à l'autre, sans imposer de
# formateur au dépôt.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2
max_line_size = 100

[*.md]
trim_trailing_whitespace = false
